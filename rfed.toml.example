# rfed.toml — Reticulum Federation Node configuration
# Copy to ~/.rfed/rfed.toml (or the directory passed to --config) and edit.
# CLI flags override these values for the current run only.
# All settings are optional; the defaults listed in comments will be used
# when a key is absent.

# ── Node identity ────────────────────────────────────────────────────────────

[node]
name                      = "my-federation-node"
announce_interval_minutes = 120        # re-announce every 2 hours (default: 360)
announce_at_start         = true       # announce immediately on startup
# lxmf_propagation        = false      # set true to accept LXMF PUTs for push-registered destinations

# ── Storage limits ───────────────────────────────────────────────────────────

[storage]
limit_mb          = 5000   # total on-disk blob store cap (default: 2000 MB)
transfer_limit_mb = 200    # max data sent to one peer per sync session
sync_limit_mb     = 800    # max data sent across all peers per sync period

# ── Peering ──────────────────────────────────────────────────────────────────

[peering]
# Known federation peers — add their 16-byte destination hashes (hex, 32 chars).
# rfed will initiate sync with these peers even before receiving their announces.
static_peers = [
    "a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4",  # peer-node-1.example
    "deadbeefdeadbeefdeadbeefdeadbeef",  # peer-node-2.example
]
from_static_only = false   # when true, only accept sync from static_peers
peering_cost     = 18      # min stamp cost we require from incoming peers

# Nodes trusted as subscriber backup delivery nodes.
# When policy.*.trusted_backup_only = true, subscribers may only nominate
# nodes whose hashes appear in this list.
# trusted_backup_peers = [
#   "aabbccddaabbccddaabbccddaabbccdd",  # backup-node-1.example
# ]

# ── Delivery policy ──────────────────────────────────────────────────────────
# Two independent tiers: "default" applies to every subscriber; "vip" applies
# to subscribers listed in [vip].
#
# stamp_cost is the required proof-of-work difficulty for inbound channel
# posts (number of required leading zero bits in the stamp hash).
# Set stamp_cost = 0 to disable PoW entirely on that tier.
#
# stamp_flexibility widens the acceptance window: a stamp with cost
#   >= (stamp_cost - stamp_flexibility)  is accepted.
# This compensates for races when the node's advertised cost changes.
#
# deferred_queue_limit caps how many blobs are held per offline subscriber.
# Oldest entries are dropped first when the limit is reached.

[policy.default]
stamp_cost              = 16     # solid PoW requirement for regular senders
stamp_flexibility       = 3      # accept costs as low as 13
deferred_queue_limit    = 256    # hold up to 256 blobs per offline subscriber
allow_push_registration = true   # may register a push notification token
allow_subscription      = true   # may subscribe to channels
max_backup_nodes        = 1      # backup delivery nodes allowed per subscriber
trusted_backup_only     = false  # set true to restrict to trusted_backup_peers

[policy.vip]
stamp_cost              = 4      # near-zero friction for trusted senders
stamp_flexibility       = 2
deferred_queue_limit    = 2048   # larger backlog for VIP subscribers
allow_push_registration = true
allow_subscription      = true
max_backup_nodes        = 5      # VIPs may nominate more backup nodes
trusted_backup_only     = false

# ── VIP subscribers ──────────────────────────────────────────────────────────
# Destination hashes (hex, 16 bytes = 32 hex chars) of subscribers that
# receive the relaxed [policy.vip] treatment.

[vip]
subscribers = [
    "cafebabecafebabecafebabecafebabe",  # Alice's phone
    "f00dcafef00dcafef00dcafef00dcafe",  # Bob's laptop
]
