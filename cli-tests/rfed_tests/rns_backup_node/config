[reticulum]
# rfed backup-test backup node — TCP hub on port 4247, connects to primary on 4246.
enable_transport = yes
share_instance = no
instance_name = rfed_backup_node

[logging]
  loglevel = 5

[interfaces]

  [[TCP Server Interface]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 127.0.0.1
    listen_port = 4247

  [[TCP Client Interface to Primary]]
    type = TCPClientInterface
    enabled = yes
    target_host = 127.0.0.1
    target_port = 4246
