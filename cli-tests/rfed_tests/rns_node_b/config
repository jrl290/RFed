[reticulum]
# rfed federation node B — second node for internode sync tests.
# Acts as its own TCP hub on port 4245.
# Also has a client connection to Node A (port 4244) so they share a mesh.
enable_transport = yes
share_instance = no
instance_name = rfed_test_node_b

[logging]
  loglevel = 5

[interfaces]

  [[TCP Server Interface]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 127.0.0.1
    listen_port = 4245

  [[TCP Client Interface to Node A]]
    type = TCPClientInterface
    enabled = yes
    target_host = 127.0.0.1
    target_port = 4244
