[reticulum]
enable_transport = no
share_instance = no

[logging]
  loglevel = 5

[interfaces]

  [[TCP Client Interface]]
    type = TCPClientInterface
    enabled = yes
    target_host = 127.0.0.1
    target_port = 4242

  [[TCP Client Interface rnsd]]
    type = TCPClientInterface
    enabled = yes
    target_host = 192.168.2.107
    target_port = 4242
