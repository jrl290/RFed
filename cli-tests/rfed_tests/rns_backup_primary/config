[reticulum]
# rfed backup-test primary node — standalone TCP hub on port 4246.
# Backup test nodes do NOT share a network with nodes A/B (ports 4244/4245).
enable_transport = yes
share_instance = no
instance_name = rfed_backup_primary

[logging]
  loglevel = 5

[interfaces]

  [[TCP Server Interface]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 127.0.0.1
    listen_port = 4246
