[reticulum]
  enable_transport = yes
  share_instance = no
  instance_name = rfed_ext_node

[logging]
  loglevel = 5

[interfaces]

  [[TCP Server Interface]]
    type = TCPServerInterface
    enabled = yes
    listen_ip = 127.0.0.1
    listen_port = 4245

  [[TCP Upstream Interface]]
    type = TCPClientInterface
    enabled = yes
    target_host = 192.168.2.107
    target_port = 4242
