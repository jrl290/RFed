[reticulum]
# Subscriber for backup failover test — connects to backup node (port 4247).
enable_transport = no
share_instance = no

[logging]
  loglevel = 5

[interfaces]

  [[TCP Client Interface to Backup]]
    type = TCPClientInterface
    enabled = yes
    target_host = 127.0.0.1
    target_port = 4247
